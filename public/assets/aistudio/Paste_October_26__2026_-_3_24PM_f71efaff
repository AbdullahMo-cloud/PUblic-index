  const generatedDate = new Date().toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

  // 1. Calculate Totals for Details Table
  let totalNewCount = 0;
  let totalNewDenominator = 0;
  let totalNewWithin = 0;
  let totalOldCount = 0;
  let totalOldWithin = 0;
  let totalOnTargetCount = 0;
  let totalOnTargetDone = 0;

  summaries.forEach((s) => {
    totalNewCount += s.newCasesCount;
    totalNewDenominator += s.newCasesDenominator;
    totalNewWithin += s.newCasesWithinSla;
    totalOldCount += s.oldCasesCount;
    totalOldWithin += s.oldCasesWithinSla;
    totalOnTargetCount += s.onTargetCount;
    totalOnTargetDone += s.onTargetCompleted;
  });

  const totalNewPct = totalNewDenominator > 0 ? Math.round((totalNewWithin / totalNewDenominator) * 100) : 0;
  const totalOldPct = totalOldCount > 0 ? Math.round((totalOldWithin / totalOldCount) * 100) : 0;
  const totalOnTargetPct = totalOnTargetCount > 0 ? Math.round((totalOnTargetDone / totalOnTargetCount) * 100) : 0;

  // Total Change Factory Index using formula
  const hasTotalNew = totalNewDenominator > 0;
  const totalNewRate = hasTotalNew ? totalNewWithin / totalNewDenominator : null;
  const hasTotalOld = totalOldCount > 0;
  const totalOldRate = hasTotalOld ? totalOldWithin / totalOldCount : null;
  const hasTotalOnTarget = totalOnTargetCount > 0;
  const totalOnTargetRate = hasTotalOnTarget ? totalOnTargetDone / totalOnTargetCount : null;

  const totalIndex = calculateChangeFactoryIndex(
    hasTotalNew,
    totalNewRate,
    hasTotalOld,
    totalOldRate,
    hasTotalOnTarget,
    totalOnTargetRate
  );

  // 2. Compute HOD Breakdown for Section 3
  const hodMap: Record<
    string,
    {
      hod: string;
      ownersCount: number;
      totalNew: number;
      newWithin: number;
      totalOld: number;
      oldWithin: number;
      onTargetTotal: number;
      onTargetDone: number;
    }
  > = {};

  summaries.forEach((s) => {
    const h = s.hod || 'General';
    if (!hodMap[h]) {
      hodMap[h] = {
        hod: h,
        ownersCount: 0,
        totalNew: 0,
        newWithin: 0,
        totalOld: 0,
        oldWithin: 0,
        onTargetTotal: 0,
        onTargetDone: 0,
      };
    }
    hodMap[h].ownersCount++;
    hodMap[h].totalNew += s.newCasesDenominator;
    hodMap[h].newWithin += s.newCasesWithinSla;
    hodMap[h].totalOld += s.oldCasesCount;
    hodMap[h].oldWithin += s.oldCasesWithinSla;
    hodMap[h].onTargetTotal += s.onTargetCount;
