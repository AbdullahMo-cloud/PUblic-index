/**
 * Exports the Owner & HOD Change Factory Index into an Excel spreadsheet
 */
export function exportExternalOwnerHodTableExcel(stats: ExternalKpiStats): void {
  const wb = XLSX.utils.book_new();

  // 1. Owner Data
  const ownerRows = (stats.ownerBreakdown || []).map((o) => ({
    'Rank': o.rank,
    'Owner': o.owner,
    'Assignee': o.assignee,
    'HOD': o.hod,
    'YTD No Dev %': `${o.noDevPct}%`,
    'YTD Dev %': `${o.devPct}%`,
    'YTD CFI INDEX': `${o.totalCfiPct}%`,
    'No Dev Cases (80%) Total': o.noDevCount,
    'No Dev Within SLA': o.noDevWithinSla,
    'No Dev Outside SLA': o.noDevOutsideSla,
    'No Dev %': `${o.noDevPct}%`,
    'Dev Cases (20%) Total': o.devCount,
    'Dev Within SLA': o.devWithinSla,
    'Dev Outside SLA': o.devOutsideSla,
    'Dev Within SLA %': `${o.devPct}%`,
    'Total Active Cases': o.totalCases,
  }));
  const wsOwners = XLSX.utils.json_to_sheet(ownerRows);
  XLSX.utils.book_append_sheet(wb, wsOwners, 'CFI By Owner');

  // 2. HOD Data
  const hodRows = (stats.hodBreakdown || []).map((h) => ({
    'Rank': h.rank,
    'HOD': h.hod,
    'Owners Count': h.ownerCount,
    'YTD No Dev %': `${h.noDevPct}%`,
    'YTD Dev %': `${h.devPct}%`,
    'YTD CFI INDEX': `${h.totalCfiPct}%`,
    'No Dev Cases (80%) Total': h.noDevCount,
    'No Dev Within SLA': h.noDevWithinSla,
    'No Dev Outside SLA': h.noDevOutsideSla,
    'No Dev %': `${h.noDevPct}%`,
    'Dev Cases (20%) Total': h.devCount,
    'Dev Within SLA': h.devWithinSla,
    'Dev Outside SLA': h.devOutsideSla,
    'Dev Within SLA %': `${h.devPct}%`,
    'Total Active Cases': h.totalCases,
  }));
  const wsHods = XLSX.utils.json_to_sheet(hodRows);
  XLSX.utils.book_append_sheet(wb, wsHods, 'CFI By HOD');

  XLSX.writeFile(wb, `etisalat_External_CFI_Owner_HOD_Performance_${new Date().getFullYear()}.xlsx`);
}

/**
 * Native, fully editable PowerPoint (.pptx) export for the External CCF KPI page.
 *
 * Mirrors the "Download HTML" report of the active tab section by section
 * (same cards, same table rows, same numbers, same colours), so the deck and
 * the HTML file are apple-to-apple with what is shown in the app:
 *   - 'matrix'      -> Executive CFI Monthly Matrix report
 *   - 'cards'       -> Executive Trend & Analytics report
 *   - 'performance' -> Owner & HOD report
 */
export type ExternalPptxScope = 'matrix' | 'cards' | 'performance';

export async function exportExternalKpiPptx(
  stats: ExternalKpiStats,
  scope: ExternalPptxScope = 'matrix'
): Promise<void> {
  const pptx = new PptxGenJS();
  // LAYOUT_WIDE = 13.33" x 7.5" (LAYOUT_16x9 is only 10" x 5.63", so wide coordinates would overflow)
  pptx.layout = 'LAYOUT_WIDE';
  pptx.author = 'etisalat External CCF Governance System';
  pptx.company = 'etisalat';

  const generatedDate = new Date().toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

  const REPORT_TITLES: Record<ExternalPptxScope, { title: string; subtitle: string; file: string }> = {
    matrix: {
      title: 'External CCF Executive CFI Monthly Matrix Report',
      subtitle: 'Official CY2026 CFI Monthly Executive Matrix & Governance Grid',
      file: 'etisalat_CFI_Monthly_Matrix_Presentation',
    },
    cards: {
      title: 'External CCF Executive Trend & Analytics Report',
      subtitle: 'Executive Column Comparison, Glide Trends & Cumulative Monthly Cards CY2026',
      file: 'etisalat_Executive_Trend_and_Analytics_Presentation',
    },
    performance: {
      title: 'Change Factory Index (Digital) — Owner & HOD Matrix',
      subtitle: 'External CFI performance by Owner (Assignee) and HOD (Team Lead)',
      file: 'etisalat_External_CFI_Owner_HOD_Presentation',
    },
  };
  const meta = REPORT_TITLES[scope];
  pptx.title = meta.title;

  // Palette (same as the HTML reports / app theme)
  const RED = 'E2001A';
  const DARK_RED = '4A0417';
  const MED_RED = '881337';
  const LIGHT_RED = '991B1B';
  const SLATE = '0F172A';
  const HEADER_BG = '18191C';
  const WHITE = 'FFFFFF';
  const PAGE_BG = 'F8FAFC';
  const EMERALD = '047857';
  const INDIGO = '4338CA';
  const GRAY = '64748B';
  const BORDER = 'CBD5E1';
  const FONT = 'Arial';
  const MONO = 'Courier New';

  const L = 'left' as const;
  const C = 'center' as const;

  type Cell = { text: string; options: Record<string, any> };
  const cell = (text: string | number, o: Record<string, any> = {}): Cell => ({
    text: String(text),
    options: { fontFace: FONT, fontSize: 8, align: C, valign: 'middle', color: SLATE, margin: [0.02, 0.03, 0.02, 0.03], ...o },
  });

  const slides: any[] = [];
  const newSlide = (title: string, subtitle: string) => {
    const slide = pptx.addSlide();
    slide.background = { color: PAGE_BG };
    slide.addShape(pptx.ShapeType.rect, { x: 0, y: 0, w: 13.33, h: 0.95, fill: { color: HEADER_BG }, line: { color: HEADER_BG, width: 0 } });
    slide.addShape(pptx.ShapeType.rect, { x: 0, y: 0, w: 13.33, h: 0.07, fill: { color: RED }, line: { color: RED, width: 0 } });
    slide.addText(
      [
        { text: 'etisalat', options: { color: RED, bold: true, fontSize: 18 } },
        { text: '   |   ', options: { color: '475569', fontSize: 16 } },
        { text: title, options: { color: WHITE, bold: true, fontSize: 16 } },
      ],
      { x: 0.5, y: 0.14, w: 9.0, h: 0.45, fontFace: FONT, margin: 0 }
    );
    slide.addText(subtitle, { x: 0.5, y: 0.58, w: 9.0, h: 0.28, fontSize: 10, color: '94A3B8', fontFace: FONT, margin: 0 });
    slide.addText(
      [
        { text: 'Period: Jan 2026 – Dec 2026\n', options: { color: 'CBD5E1', fontSize: 9 } },
        { text: `Generated: ${generatedDate}\n`, options: { color: 'CBD5E1', fontSize: 9 } },
        { text: 'Target Threshold: 100% CFI Score', options: { color: WHITE, bold: true, fontSize: 9 } },
      ],
      { x: 9.3, y: 0.1, w: 3.55, h: 0.78, align: 'right', fontFace: FONT, margin: 0 }
    );
    slides.push(slide);
    return slide;
  };

  const sectionTitle = (slide: any, text: string, right: string, y = 1.1) => {
    slide.addText(text, { x: 0.5, y, w: 8.5, h: 0.32, fontSize: 13, bold: true, color: SLATE, fontFace: FONT, margin: 0 });
    if (right) slide.addText(right, { x: 8.0, y, w: 4.83, h: 0.32, fontSize: 10, bold: true, color: GRAY, align: 'right', fontFace: FONT, margin: 0 });
    slide.addShape(pptx.ShapeType.line, { x: 0.5, y: y + 0.36, w: 12.33, h: 0, line: { color: 'E2E8F0', width: 1.5 } });
  };

  // ---------- Shared building blocks (identical to the HTML reports) ----------
  const addKpiCards = (slide: any, variant: 'matrix' | 'trend', y = 1.25, h = 2.55) => {
    const cards = [
      {
        label: 'TOTAL CFI ACTUAL INDEX',
        badge: '100% Target Benchmark',
        value: `${stats.overallCfiScore.toFixed(2)}%`,
        desc:
          variant === 'matrix'
            ? 'Composite score blending No Dev (80% Wt) & Dev Required (20% Wt) stream compliance.'
            : 'Blending No Dev (80% Wt) & Dev Required (20% Wt)',
        status:
          stats.overallCfiScore >= 100
            ? `Target Met / Exceeded (+${(stats.overallCfiScore - 100).toFixed(1)}%)`
            : 'Below Target Threshold',
        accent: RED, fill: 'FFF1F2', statusColor: '9F1239',
      },
      {
        label: 'NO DEV STREAM (≤90d SLA)',
        badge: '80% Target | 80% Wt',
        value: `${stats.noDevOverallPct}%`,
        desc:
          variant === 'matrix'
            ? `${stats.noDevWithinSlaCount} of ${stats.noDevTotalCount} cases resolved in ≤90 days (${stats.noDevContPct}% volume share).`
            : `${stats.noDevWithinSlaCount} of ${stats.noDevTotalCount} cases within SLA (${stats.noDevContPct}% volume)`,
        status: stats.noDevOverallPct >= 80 ? 'SLA Compliant Stream' : 'Non-Compliant Stream',
        accent: '10B981', fill: 'ECFDF5', statusColor: '065F46', valueColor: EMERALD,
      },
      {
        label: 'DEV REQUIRED STREAM (≤180d SLA)',
        badge: '80% Target | 20% Wt',
        value: `${stats.devOverallPct}%`,
        desc:
          variant === 'matrix'
            ? `${stats.devWithinSlaCount} of ${stats.devTotalCount} cases resolved in ≤180 days (${stats.devContPct}% volume share).`
            : `${stats.devWithinSlaCount} of ${stats.devTotalCount} cases within SLA (${stats.devContPct}% volume)`,
        status: stats.devOverallPct >= 80 ? 'SLA Compliant Stream' : 'Non-Compliant Stream',
        accent: '6366F1', fill: 'EEF2FF', statusColor: '3730A3', valueColor: INDIGO,
      },
    ];
    const w = 3.95;
    const gap = 0.24;
    cards.forEach((c, i) => {
      const x = 0.5 + i * (w + gap);
      slide.addShape(pptx.ShapeType.rect, { x, y, w, h, fill: { color: c.fill }, line: { color: 'E2E8F0', width: 1 } });
      slide.addShape(pptx.ShapeType.rect, { x, y, w: 0.07, h, fill: { color: c.accent }, line: { color: c.accent, width: 0 } });
      slide.addText(c.label, { x: x + 0.25, y: y + 0.15, w: w - 0.4, h: 0.28, fontSize: 10, bold: true, color: GRAY, fontFace: FONT, margin: 0 });
      slide.addText(c.badge, { x: x + 0.25, y: y + 0.45, w: 2.0, h: 0.24, fontSize: 8, bold: true, color: c.statusColor, fontFace: FONT, margin: 0 });
      slide.addText(c.value, { x: x + 0.25, y: y + 0.75, w: w - 0.4, h: 0.8, fontSize: 36, bold: true, color: (c as any).valueColor || RED, fontFace: MONO, margin: 0 });
      slide.addText(c.desc, { x: x + 0.25, y: y + 1.6, w: w - 0.45, h: 0.55, fontSize: 10, color: '475569', fontFace: FONT, valign: 'top', margin: 0 });
      slide.addText(variant === 'matrix' ? c.status : '', { x: x + 0.25, y: y + h - 0.4, w: w - 0.4, h: 0.28, fontSize: 10, bold: true, color: c.statusColor, fontFace: FONT, margin: 0 });
    });
  };

  const monthCols = stats.monthlyData.length;

  // Month columns share the remaining width so the grid always fits the slide
  const matrixColW = (first: number[], total = 12.33) => {
    const used = first.reduce((a, b) => a + b, 0);
    const each = (total - used) / Math.max(monthCols, 1);
    return [...first, ...Array(monthCols).fill(each)];
  };

  const sectionRow = (label: string, target: string, weight: string, fill: string, values: string[]) => [
    cell(label, { align: L, bold: true, color: WHITE, fill: { color: fill }, fontSize: 8.5 }),
    cell(target, { bold: true, color: WHITE, fill: { color: fill }, fontSize: 8.5 }),
    cell(weight, { bold: true, color: WHITE, fill: { color: fill }, fontSize: 8.5 }),
    ...values.map((v) => cell(v, { bold: true, color: WHITE, fill: { color: fill }, fontSize: 8.5 })),
  ];

  const subRow = (
    label: string,
    weight: string,
    weightColor: string,
    values: Array<{ v: string; color?: string; bold?: boolean }>,
    opts: { fill?: string; italic?: boolean; boldLabel?: boolean } = {}
  ) => {
    const fill = { color: opts.fill || WHITE };
    return [
      cell(`   ${label}`, { align: L, fill, italic: opts.italic, bold: opts.boldLabel }),
      cell('-', { fill, color: GRAY }),
      cell(weight, { fill, color: weightColor, bold: weight !== '-' }),
      ...values.map((x) => cell(x.v, { fill, color: x.color || SLATE, bold: !!x.bold })),
    ];
  };

  const headRow = (labels: string[]) =>
    labels.map((t, i) => cell(t, { align: i === 0 ? L : C, bold: true, color: SLATE, fill: { color: 'E2E8F0' }, fontSize: 8.5 }));

  const tableBorder = { type: 'solid' as const, pt: 0.75, color: BORDER };

  // ---------- Cover ----------
  {
    const slide = pptx.addSlide();
    slide.background = { color: HEADER_BG };
    slides.push(slide);
    slide.addShape(pptx.ShapeType.rect, { x: 0, y: 0, w: 13.33, h: 0.18, fill: { color: RED }, line: { color: RED, width: 0 } });
    slide.addText('etisalat', { x: 0.9, y: 1.7, w: 11, h: 0.9, fontSize: 46, bold: true, color: RED, fontFace: FONT, margin: 0 });
    slide.addText(meta.title, { x: 0.9, y: 2.65, w: 11.5, h: 0.8, fontSize: 26, bold: true, color: WHITE, fontFace: FONT, margin: 0 });
    slide.addText(meta.subtitle, { x: 0.9, y: 3.5, w: 11.5, h: 0.45, fontSize: 14, color: '94A3B8', fontFace: FONT, margin: 0 });
    slide.addShape(pptx.ShapeType.rect, { x: 0.9, y: 4.6, w: 11.53, h: 1.7, fill: { color: '23252B' }, line: { color: '334155', width: 1 } });
    slide.addText(
      [
        { text: `Period: Jan 2026 – Dec 2026\n`, options: { fontSize: 12, color: WHITE } },
        { text: `Generated: ${generatedDate}\n`, options: { fontSize: 12, color: WHITE } },
        { text: `Target Threshold: 100% CFI Score   |   Weights: No Dev (≤90d) 80%  ·  Dev Required (≤180d) 20%\n`, options: { fontSize: 12, color: WHITE } },
        { text: 'Generated automatically from Live Database Engine | Confidential & Executive Distribution', options: { fontSize: 10, color: '94A3B8' } },
      ],
      { x: 1.2, y: 4.75, w: 11, h: 1.4, fontFace: FONT, valign: 'middle', margin: 0 }
    );
  }

  // =========================================================================
  // MATRIX REPORT
  // =========================================================================
  if (scope === 'matrix') {
    // 1. KPI cards
    {
      const slide = newSlide('Executive KPI Summary', 'Total CFI Actual Index, No Dev stream and Dev Required stream');
      sectionTitle(slide, 'Executive KPI Summary Cards', 'No Dev (80% Wt) & Dev Required (20% Wt)');
      addKpiCards(slide, 'matrix', 1.7, 3.1);
    }

    const m = stats.monthlyData;
    const months = m.map((x) => x.month);
    const colW = matrixColW([3.3, 0.75, 1.15]);
    const head = headRow(['CFI METRIC / CATEGORY', 'TARGET', 'WEIGHT / SHARE', ...months]);
    const out = (n: number) => ({ v: String(n), color: n > 0 ? 'B91C1C' : GRAY, bold: n > 0 });

    // 2a. No Dev + Dev Required sections
    {
      const slide = newSlide('Executive CFI Monthly Matrix (1/2)', 'No Dev (80% Wt) & Dev Required (20% Wt) — segregated SLA score');
      sectionTitle(slide, 'Reorganized Executive CFI Monthly Matrix (e& Corporate Grid)', 'Segregated No Dev (80% Wt) & Dev Required (20% Wt)');
      const rows = [
        head,
        sectionRow('1. No Dev (SLA Score %) — ≤90d SLA', '80%', '80% Weight', DARK_RED, m.map((x) => `${x.noDevPct}%`)),
        subRow('Count (Total Cases)', `${stats.noDevContPct}% Share`, MED_RED, m.map((x) => ({ v: String(x.noDevCount) }))),
        subRow('Within SLA (≤90d)', '-', GRAY, m.map((x) => ({ v: String(x.noDevWithinSla), color: EMERALD, bold: true }))),
        subRow('Outside SLA (>90d)', '-', GRAY, m.map((x) => out(x.noDevOutsideSla))),
        subRow('Unresolved Cases', '-', GRAY, m.map((x) => ({ v: String(x.noDevUnresolved) })), { italic: true }),
        sectionRow('2. Dev Required (SLA Score %) — ≤180d SLA', '80%', '20% Weight', MED_RED, m.map((x) => `${x.devPct}%`)),
        subRow('Count (Total Cases)', `${stats.devContPct}% Share`, '3730A3', m.map((x) => ({ v: String(x.devCount) }))),
        subRow('Within SLA (≤180d)', '-', GRAY, m.map((x) => ({ v: String(x.devWithinSla), color: INDIGO, bold: true }))),
        subRow('Outside SLA (>180d)', '-', GRAY, m.map((x) => out(x.devOutsideSla))),
        subRow('Unresolved Cases', '-', GRAY, m.map((x) => ({ v: String(x.devUnresolved) })), { italic: true }),
      ];
      slide.addTable(rows as any, { x: 0.5, y: 1.65, w: 12.33, colW, rowH: 0.42, border: tableBorder });
    }

    // 2b. Total CFI + volume sections
    {
      const slide = newSlide('Executive CFI Monthly Matrix (2/2)', 'Total CFI Actual Index vs Glide Target and case volume metrics');
      sectionTitle(slide, 'Reorganized Executive CFI Monthly Matrix (e& Corporate Grid)', 'Total CFI Index & Operational Volume');
      const rows = [
        head,
        sectionRow('3. TOTAL CFI ACTUAL INDEX', '100%', '100% Weight', LIGHT_RED, m.map((x) => `${x.totalCfiPct.toFixed(1)}%`)),
        subRow('Glide Target Benchmark', '-', GRAY, m.map((x) => ({ v: `${x.glidePct}%` })), { fill: 'F8FAFC', italic: true }),
        subRow(
          'Performance Variance vs Glide', '-', GRAY,
          m.map((x) => {
            const d = x.totalCfiPct - x.glidePct;
            return { v: `${d >= 0 ? '+' : ''}${d.toFixed(1)}%`, color: d >= 0 ? '065F46' : '9F1239', bold: true };
          }),
          { fill: 'FFF1F2', boldLabel: true }
        ),
        sectionRow('4. Case Volume Operational Metrics', '-', '-', SLATE, m.map((x) => String(x.totalCases))),
        subRow('TOTAL Cumulative Cases', '-', GRAY, m.map((x) => ({ v: String(x.totalCases) }))),
        subRow('For Monitoring / Completed', '-', GRAY, m.map((x) => ({ v: String(x.forMonitoringCompleted), color: EMERALD, bold: true }))),
        subRow('Active Case Pool', '-', GRAY, m.map((x) => ({ v: String(x.activeCases), color: 'B91C1C', bold: true }))),
        subRow('% Closed / Monitored', '-', GRAY, m.map((x) => ({ v: `${x.pctClosed}%`, color: '0369A1', bold: true })), { boldLabel: true }),
      ];
      slide.addTable(rows as any, { x: 0.5, y: 1.65, w: 12.33, colW, rowH: 0.45, border: tableBorder });
    }
  }

  // Executive Monthly Trend grid (used by matrix + trend reports, same rows as HTML)
  const addTrendGridSlide = (title: string, subtitle: string, sectionLabel: string) => {
    const m = stats.monthlyData;
    const slide = newSlide(title, subtitle);
    sectionTitle(slide, sectionLabel, '12-month executive trend');
    const colW = matrixColW([3.1]);
    const rows = [
      headRow(['Metric / Month', ...m.map((x) => x.month)]),
      [
        cell('TOTAL CFI Actual Score %', { align: L, bold: true, color: MED_RED, fill: { color: 'F8FAFC' }, fontSize: 9 }),
        ...m.map((x) => {
          const ok = x.totalCfiPct >= x.glidePct;
          return cell(`${x.totalCfiPct.toFixed(2)}%`, { bold: true, color: ok ? '065F46' : '9F1239', fill: { color: ok ? 'ECFDF5' : 'FFF1F2' } });
        }),
      ],
      [
        cell('Glide Target Benchmark %', { align: L, bold: true, color: '475569', fill: { color: 'F8FAFC' }, fontSize: 9 }),
        ...m.map((x) => cell(`${x.glidePct}%`)),
      ],
      [
        cell('No Dev Stream SLA % (≤90d)', { align: L, bold: true, color: EMERALD, fill: { color: 'F8FAFC' }, fontSize: 9 }),
        ...m.map((x) => cell(`${x.noDevPct}%`, { bold: true, color: '065F46' })),
      ],
      [
        cell('Dev Required Stream SLA % (≤180d)', { align: L, bold: true, color: INDIGO, fill: { color: 'F8FAFC' }, fontSize: 9 }),
        ...m.map((x) => cell(`${x.devPct}%`, { bold: true, color: '3730A3' })),
      ],
      [
        cell('Active Operational Pool', { align: L, bold: true, color: SLATE, fill: { color: 'F8FAFC' }, fontSize: 9 }),
        ...m.map((x) => cell(String(x.totalCases))),
      ],
    ];
    slide.addTable(rows as any, { x: 0.5, y: 1.65, w: 12.33, colW, rowH: 0.55, border: tableBorder });
  };

  if (scope === 'matrix') {
    addTrendGridSlide('Executive Monthly Trend Analytics Grid', 'TOTAL CFI vs Glide, stream SLA % and active operational pool', 'Executive Monthly Trend Analytics Grid');
  }

  // =========================================================================
  // TREND & ANALYTICS REPORT
  // =========================================================================
  if (scope === 'cards') {
    const m = stats.monthlyData;

    // 1. KPI cards
    {
      const slide = newSlide('Executive KPI Summary', 'Total CFI Actual Index, No Dev stream and Dev Required stream');
      sectionTitle(slide, 'Executive KPI Summary Cards', 'No Dev (80% Wt) & Dev Required (20% Wt)');
      addKpiCards(slide, 'trend', 1.7, 2.6);
    }

    // 2. Column chart + glide trend (native, editable chart)
    {
      const slide = newSlide('Executive Monthly CFI Column Chart & Glide Trend', 'No Dev, Dev Required, Total CFI Score vs Glide Target (50% → 90%)');
      sectionTitle(slide, 'Executive Monthly CFI Column Chart & Glide Trend', 'Target Benchmark: 100% Composite Index');
      const labels = m.map((x) => x.month);
      try {
        slide.addChart(
          [
            {
              type: pptx.ChartType.bar,
              data: [
                { name: 'No Dev SLA % (80% Weight)', labels, values: m.map((x) => x.noDevPct) },
                { name: 'Dev Required SLA % (20% Weight)', labels, values: m.map((x) => x.devPct) },
                { name: 'Total CFI Actual %', labels, values: m.map((x) => Number(x.totalCfiPct.toFixed(1))) },
              ],
              options: { chartColors: ['059669', '4338CA', SLATE], barGrouping: 'clustered', barGapWidthPct: 60 },
            },
            {
              type: pptx.ChartType.line,
              data: [{ name: 'Glide Target', labels, values: m.map((x) => x.glidePct) }],
              options: { chartColors: ['F59E0B'], lineSize: 2, lineDataSymbolSize: 6 },
            },
          ] as any,
          {
            x: 0.5, y: 1.65, w: 12.33, h: 4.6,
            showLegend: true, legendPos: 'b', legendFontSize: 10, legendFontFace: FONT,
            valAxisMinVal: 0, valAxisMaxVal: 120, valAxisMajorUnit: 20,
            valAxisLabelFontSize: 9, catAxisLabelFontSize: 10,
            valGridLine: { color: 'E2E8F0', size: 0.5 },
            showValue: false,
          } as any
        );
      } catch (e) {
        console.warn('Native chart could not be created:', e);
      }
      // Variance vs glide strip (same "+x.x%" badge as the HTML chart)
      const cw = 12.33 / Math.max(m.length, 1);
      m.forEach((x, i) => {
        const d = x.totalCfiPct - x.glidePct;
        slide.addText(`${d >= 0 ? '+' : ''}${d.toFixed(1)}%`, {
          x: 0.5 + i * cw, y: 6.4, w: cw, h: 0.3, align: C, fontSize: 9, bold: true, fontFace: MONO,
          color: d >= 0 ? '065F46' : '9F1239', margin: 0,
        });
      });
      slide.addText('Variance vs Glide', { x: 0.5, y: 6.7, w: 12.33, h: 0.25, align: C, fontSize: 8, color: GRAY, fontFace: FONT, margin: 0 });
    }

    // 3. Category stream cards
    {
      const slide = newSlide('Stream Category Breakdown', 'No Dev Stream and Dev Required Stream categories');
      sectionTitle(slide, 'Category Stream Breakdown', 'Weighted 80% / 20%');
      const cats = [
        { name: 'No Dev Stream Category', sub: '80% Target | 80% Weight Contribution | ≤90d SLA', pct: stats.noDevOverallPct, within: stats.noDevWithinSlaCount, total: stats.noDevTotalCount, share: stats.noDevContPct, win: '(≤90d)', accent: '10B981', color: EMERALD, shareColor: '065F46' },
        { name: 'Dev Required Stream Category', sub: '80% Target | 20% Weight Contribution | ≤180d SLA', pct: stats.devOverallPct, within: stats.devWithinSlaCount, total: stats.devTotalCount, share: stats.devContPct, win: '(≤180d)', accent: '6366F1', color: INDIGO, shareColor: '3730A3' },
      ];
      cats.forEach((c, i) => {
        const x = 0.5 + i * 6.3;
        const w = 6.03;
        const y = 1.7;
        slide.addShape(pptx.ShapeType.rect, { x, y, w, h: 3.2, fill: { color: WHITE }, line: { color: 'E2E8F0', width: 1 } });
        slide.addShape(pptx.ShapeType.rect, { x, y, w: 0.07, h: 3.2, fill: { color: c.accent }, line: { color: c.accent, width: 0 } });
        slide.addText(c.name, { x: x + 0.3, y: y + 0.2, w: 3.9, h: 0.3, fontSize: 14, bold: true, color: SLATE, fontFace: FONT, margin: 0 });
        slide.addText(c.sub, { x: x + 0.3, y: y + 0.52, w: 4.2, h: 0.25, fontSize: 9, color: GRAY, fontFace: FONT, margin: 0 });
        slide.addText(`${c.pct}%`, { x: x + w - 1.9, y: y + 0.15, w: 1.7, h: 0.6, fontSize: 26, bold: true, color: c.color, align: 'right', fontFace: MONO, margin: 0 });
        const boxes = [
          { l: `Within SLA ${c.win}`, v: String(c.within), color: c.color },
          { l: 'Total Cases', v: String(c.total), color: SLATE },
          { l: 'Volume Cont', v: `${c.share}%`, color: c.shareColor },
        ];
        boxes.forEach((b, j) => {
          const bx = x + 0.3 + j * 1.85;
          slide.addShape(pptx.ShapeType.rect, { x: bx, y: y + 1.2, w: 1.7, h: 1.5, fill: { color: 'F8FAFC' }, line: { color: 'E2E8F0', width: 1 } });
          slide.addText(b.l, { x: bx, y: y + 1.35, w: 1.7, h: 0.3, fontSize: 9, color: GRAY, align: C, fontFace: FONT, margin: 0 });
          slide.addText(b.v, { x: bx, y: y + 1.75, w: 1.7, h: 0.6, fontSize: 24, bold: true, color: b.color, align: C, fontFace: MONO, margin: 0 });
        });
      });
    }

    // 4. 12-month cumulative cards (4 x 3 grid)
    {
      const slide = newSlide('Cumulative Monthly Executive Cards (Jan to Dec 2026)', 'Monthly breakdown of cumulative cases, stream scores and operational progress');
      sectionTitle(slide, 'Cumulative Monthly Executive Cards (Jan to Dec 2026)', 'Cumulative through each month');
      const cols = 4;
      const cw = 2.9;
      const ch = 1.62;
      const gx = (12.33 - cols * cw) / (cols - 1);
      m.forEach((x, i) => {
        const cx = 0.5 + (i % cols) * (cw + gx);
        const cy = 1.65 + Math.floor(i / cols) * (ch + 0.12);
        slide.addShape(pptx.ShapeType.rect, { x: cx, y: cy, w: cw, h: ch, fill: { color: WHITE }, line: { color: 'E2E8F0', width: 1 } });
        slide.addText(x.month, { x: cx + 0.12, y: cy + 0.06, w: 1.2, h: 0.3, fontSize: 13, bold: true, color: SLATE, fontFace: FONT, margin: 0 });
        slide.addText(`${x.totalCfiPct.toFixed(1)}%`, { x: cx + cw - 1.1, y: cy + 0.07, w: 0.98, h: 0.27, fontSize: 10.5, bold: true, color: '065F46', fill: { color: 'D1FAE5' }, align: C, fontFace: MONO, margin: 0 });
        slide.addText(
          [
            { text: 'Cumulative Cases: ', options: { color: GRAY } },
            { text: `${x.totalCases}\n`, options: { bold: true, color: SLATE } },
            { text: 'No Dev (≤90d): ', options: { color: EMERALD, bold: true } },
            { text: `${x.noDevPct}% (${x.noDevWithinSla}/${x.noDevCount})\n`, options: { bold: true, color: '065F46' } },
            { text: 'Dev Required (≤180d): ', options: { color: INDIGO, bold: true } },
            { text: `${x.devPct}% (${x.devWithinSla}/${x.devCount})\n`, options: { bold: true, color: '3730A3' } },
            { text: 'Closed / Monitored: ', options: { color: GRAY } },
            { text: `${x.pctClosed}%`, options: { bold: true, color: '0284C7' } },
          ],
          { x: cx + 0.12, y: cy + 0.42, w: cw - 0.2, h: ch - 0.5, fontSize: 8.5, fontFace: FONT, valign: 'top', margin: 0 }
        );
      });
    }

    // 5. Trend summary grid
    addTrendGridSlide('Executive Monthly Trend & Analytics Summary Grid', 'TOTAL CFI vs Glide, stream SLA % and active operational pool', 'Executive Monthly Trend & Analytics Summary Grid');
  }

  // =========================================================================
  // OWNER & HOD REPORT
  // =========================================================================
  if (scope === 'performance') {
    const owners = stats.ownerBreakdown || [];
    const hods = stats.hodBreakdown || [];

    const sum = (arr: any[], k: string) => arr.reduce((a, o) => a + (o[k] || 0), 0);
    const totalNoDevCount = sum(owners, 'noDevCount');
    const totalNoDevWithin = sum(owners, 'noDevWithinSla');
    const totalNoDevOutside = sum(owners, 'noDevOutsideSla');
    const totalNoDevPct = totalNoDevCount > 0 ? Math.round((totalNoDevWithin / totalNoDevCount) * 100) : 0;
    const totalDevCount = sum(owners, 'devCount');
    const totalDevWithin = sum(owners, 'devWithinSla');
    const totalDevOutside = sum(owners, 'devOutsideSla');
    const totalDevPct = totalDevCount > 0 ? Math.round((totalDevWithin / totalDevCount) * 100) : 0;
    const overallIndex =
      totalNoDevCount > 0 && totalDevCount > 0
        ? Math.round(totalNoDevPct + (totalDevPct / 80) * 20)
        : totalNoDevCount > 0
        ? Math.round((totalNoDevPct / 80) * 100)
        : totalDevCount > 0
        ? Math.round((totalDevPct / 80) * 100)
        : 0;

    const gh = (t: string, span: number, fill = SLATE) => ({
      text: t,
      options: { colspan: span, fontFace: FONT, fontSize: 7.5, bold: true, align: C, valign: 'middle', color: WHITE, fill: { color: fill } },
    });
    const sh = (t: string, fill = 'E2E8F0', color = SLATE) => cell(t, { bold: true, fontSize: 7, color, fill: { color: fill } });
    const pctCell = (p: number) => cell(`${p}%`, { fontSize: 7.5, bold: p >= 80, color: p >= 80 ? '065F46' : SLATE, fill: { color: p >= 80 ? 'D1FAE5' : WHITE } });
    const rankFill = (r: number) => (r === 1 ? 'FEF3C7' : r === 2 ? 'E2E8F0' : r === 3 ? 'FFEDD5' : WHITE);

    // columns: [rank, name, (assignee), hod / owners, ytd x3, nodev x4, dev x4]
    const buildTable = (kind: 'owner' | 'hod', rows: any[], withTotal: boolean) => {
      const lead = kind === 'owner' ? 4 : 3;
      const group = [
        gh(kind === 'owner' ? 'CHANGE FACTORY INDEX - DIGITAL' : 'CHANGE FACTORY INDEX - DIGITAL (HOD SUMMARY)', lead, DARK_RED),
        gh('YTD', 3, MED_RED),
        gh('NO DEV CASES (80%)', 4, EMERALD),
        gh('DEV CASES (20%)', 4, INDIGO),
      ];
      const sub =
        kind === 'owner'
          ? [sh('Rank'), sh('Owner'), sh('Assignee'), sh('HOD')]
          : [sh('Rank'), sh('HOD'), sh('Owners Count')];
      const header2 = [
        ...sub,
        sh('NO DEV'), sh('DEV'), sh('INDEX', 'D1FAE5', '065F46'),
        sh('Count'), sh('Within SLA'), sh('Outside SLA'), sh('%'),
        sh('Count'), sh('Within SLA'), sh('Outside SLA'), sh('Within SLA %'),
      ];
      const body = rows.map((o) => {
        const first =
          kind === 'owner'
            ? [
                cell(`#${o.rank}`, { bold: true, fill: { color: rankFill(o.rank) } }),
                cell(o.owner, { align: L, bold: true, fontSize: 7.5 }),
                cell(o.assignee, { fontSize: 7 }),
                cell(o.hod, { fontSize: 7 }),
              ]
            : [
                cell(`#${o.rank}`, { bold: true, fill: { color: rankFill(o.rank) } }),
                cell(o.hod, { align: L, bold: true, fontSize: 8 }),
                cell(`${o.ownerCount} owners`, { fontSize: 7.5 }),
              ];
        return [
          ...first,
          cell(`${o.noDevPct}%`, { bold: true }),
          cell(`${o.devPct}%`, { bold: true }),
          cell(`${o.totalCfiPct}%`, { bold: true, color: '065F46', fill: { color: 'D1FAE5' }, fontSize: 8 }),
          cell(o.noDevCount),
          cell(o.noDevWithinSla, { bold: true, color: EMERALD }),
          cell(o.noDevOutsideSla, { color: 'DC2626' }),
          pctCell(o.noDevPct),
          cell(o.devCount),
          cell(o.devWithinSla, { bold: true, color: EMERALD }),
          cell(o.devOutsideSla, { color: 'DC2626' }),
          pctCell(o.devPct),
        ];
      });
      const totalRow = withTotal
        ? [
            [
              { text: 'TOTAL / SUMMARY', options: { colspan: lead, fontFace: FONT, fontSize: 8, bold: true, align: L, valign: 'middle', color: WHITE, fill: { color: SLATE } } },
              ...[`${totalNoDevPct}%`, `${totalDevPct}%`].map((t) => cell(t, { bold: true, color: WHITE, fill: { color: SLATE } })),
              cell(`${overallIndex}%`, { bold: true, color: WHITE, fill: { color: '059669' }, fontSize: 9 }),
              ...[totalNoDevCount, totalNoDevWithin, totalNoDevOutside, `${totalNoDevPct}%`, totalDevCount, totalDevWithin, totalDevOutside, `${totalDevPct}%`].map((t) =>
                cell(t, { bold: true, color: WHITE, fill: { color: SLATE } })
              ),
            ],
          ]
        : [];
      const widths =
        kind === 'owner'
          ? [0.5, 1.55, 1.55, 1.1, 0.6, 0.6, 0.7, 0.58, 0.78, 0.78, 0.55, 0.58, 0.78, 0.78, 0.72]
          : [0.5, 2.9, 1.2, 0.7, 0.7, 0.75, 0.6, 0.8, 0.8, 0.6, 0.6, 0.8, 0.8, 0.78];
      return { rows: [group, header2, ...body, ...totalRow], colW: widths };
    };

    // Owner table, paginated like a long table would flow in the HTML (13 owners / slide)
    const PAGE = 13;
    const pages = Math.max(1, Math.ceil(owners.length / PAGE));
    for (let p = 0; p < pages; p++) {
      const slice = owners.slice(p * PAGE, (p + 1) * PAGE);
      const last = p === pages - 1;
      const slide = newSlide(
        'Performance By Owner (Assignee)' + (pages > 1 ? ` (${p + 1}/${pages})` : ''),
        'Change Factory Index — Owner level: YTD, No Dev (80%) and Dev (20%) cases'
      );
      sectionTitle(slide, 'Change Factory Index — Performance By Owner (Assignee)', `${owners.length} owners`);
      const t = buildTable('owner', slice, last);
      const sumW = t.colW.reduce((a, b) => a + b, 0);
      slide.addTable(t.rows as any, { x: 0.5, y: 1.6, w: 12.33, colW: t.colW.map((w) => (w * 12.33) / sumW), rowH: 0.3, border: tableBorder });
    }

    // HOD table
    {
      const slide = newSlide('Performance By HOD (Team Lead)', 'Change Factory Index — HOD summary: YTD, No Dev (80%) and Dev (20%) cases');
      sectionTitle(slide, 'Change Factory Index — Performance By HOD (Team Lead)', `${hods.length} HODs`);
      const t = buildTable('hod', hods, true);
      const sumW = t.colW.reduce((a, b) => a + b, 0);
      slide.addTable(t.rows as any, { x: 0.5, y: 1.6, w: 12.33, colW: t.colW.map((w) => (w * 12.33) / sumW), rowH: 0.34, border: tableBorder });
      slide.addText("Methodology: Excludes 'Not Started', 'New', and 'Cancelled' cases. Weighted 80% No Dev (≤90d) & 20% Dev (≤180d).", {
        x: 0.5, y: 6.55, w: 12.33, h: 0.3, fontSize: 9, color: GRAY, fontFace: FONT, margin: 0,
      });
    }
  }

  // ---------- Footers with page numbers ----------
  const total = slides.length;
  slides.forEach((slide, i) => {
    if (i === 0) return; // cover
    slide.addText(
      `etisalat Corporate Governance Framework  |  External CCF Operational System  |  Page ${i + 1} of ${total}`,
      { x: 0.5, y: 7.1, w: 12.33, h: 0.28, fontSize: 8, color: GRAY, fontFace: FONT, margin: 0 }
    );
  });

  await pptx.writeFile({ fileName: `${meta.file}_${new Date().getFullYear()}.pptx` });
}