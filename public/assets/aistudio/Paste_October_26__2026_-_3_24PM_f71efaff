/**
 * Capture an HTML DOM element by ID into a high-DPI PNG Data URL
 */
export async function captureElementToPng(elementId: string): Promise<string | null> {
  const el = document.getElementById(elementId);
  if (!el) return null;

  const wasHidden = window.getComputedStyle(el).display === 'none';
  const originalDisplay = el.style.display;
  const originalPosition = el.style.position;
  const originalLeft = el.style.left;
  const originalTop = el.style.top;
  const originalWidth = el.style.width;
  const originalZIndex = el.style.zIndex;

  try {
    if (wasHidden) {
      el.style.display = 'block';
      el.style.position = 'absolute';
      el.style.left = '-9999px';
      el.style.top = '0px';
      el.style.width = '1280px';
      el.style.zIndex = '-9999';
    }

    // Short tick for layout / fonts to settle
    await new Promise((resolve) => setTimeout(resolve, 150));

    const dataUrl = await toPng(el, {
      quality: 0.98,
      pixelRatio: 2,
      backgroundColor: '#ffffff',
      cacheBust: true,
      filter: (node) => {
        if (node instanceof HTMLElement && node.classList.contains('no-export')) {
          return false;
        }
        return true;
      },
    });

    return dataUrl;
  } catch (err) {
    console.warn(`[captureElementToPng] Could not snapshot #${elementId}:`, err);
    return null;
  } finally {
    if (wasHidden) {
      el.style.display = originalDisplay;
      el.style.position = originalPosition;
      el.style.left = originalLeft;
      el.style.top = originalTop;
      el.style.width = originalWidth;
      el.style.zIndex = originalZIndex;
    }
  }
}

