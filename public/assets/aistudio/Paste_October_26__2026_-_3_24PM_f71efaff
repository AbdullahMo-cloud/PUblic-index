  const hodList = Object.values(hodMap)
    .map((item) => {
      const newPct = item.totalNew > 0 ? Math.round((item.newWithin / item.totalNew) * 100) : 0;
      const oldPct = item.totalOld > 0 ? Math.round((item.oldWithin / item.totalOld) * 100) : 0;
      const onTargetPct = item.onTargetTotal > 0 ? Math.round((item.onTargetDone / item.onTargetTotal) * 100) : 0;

      const hasNew = item.totalNew > 0;
      const newRate = hasNew ? item.newWithin / item.totalNew : null;
      const hasOld = item.totalOld > 0;
      const oldRate = hasOld ? item.oldWithin / item.totalOld : null;
      const hasOnTarget = item.onTargetTotal > 0;
      const onTargetRate = hasOnTarget ? item.onTargetDone / item.onTargetTotal : null;

      const compositeIndex = calculateChangeFactoryIndex(hasNew, newRate, hasOld, oldRate, hasOnTarget, onTargetRate);
      return {
        ...item,
        newPct,
        oldPct,
        onTargetPct,
        compositeIndex,
      };
    })
    .sort((a, b) => b.compositeIndex - a.compositeIndex);

  // 3. Sorted Owners for Section 2 (Visualizer)
  const sortedOwners = [...summaries].sort((a, b) => b.changeFactoryIndex - a.changeFactoryIndex);
